# Veritabani (varsayilan SQLite; uretimde PostgreSQL onerilir)
DATABASE_URL=sqlite:///./data/antrenor.db

# Tarama
SCRAPE_INTERVAL_MINUTES=30
SCRAPE_CONCURRENCY=6
FETCH_DETAIL_PAGES=1

# Kimlik dogrulama
JWT_SECRET=uzun-rastgele-bir-deger-uretin

# Push (Firebase Cloud Messaging)
PUSH_ENABLED=0
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=./secrets/fcm-service-account.json

# Kurumsal
APP_NAME=Antrenor
SUPPORT_EMAIL=destek@antrenorapp.com
PUBLIC_BASE_URL=https://api.antrenorapp.com
