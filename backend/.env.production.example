# ---- Alan adi ve TLS
API_DOMAIN=api.antrenorapp.com
PUBLIC_BASE_URL=https://api.antrenorapp.com
CORS_ORIGINS=https://antrenorapp.com,https://www.antrenorapp.com

# ---- Veritabani (docker compose icindeki db servisi)
POSTGRES_USER=antrenor
POSTGRES_PASSWORD=buraya-guclu-bir-parola
POSTGRES_DB=antrenor
DATABASE_URL=postgresql+psycopg://antrenor:buraya-guclu-bir-parola@db:5432/antrenor

# ---- Kimlik dogrulama
# openssl rand -hex 32   ile uretin
JWT_SECRET=degistirin-uzun-rastgele-deger

# ---- Tarama
SCRAPE_INTERVAL_MINUTES=30
SCRAPE_CONCURRENCY=6
FETCH_DETAIL_PAGES=1
MAX_ITEMS_PER_SOURCE=40

# ---- Bildirim (Firebase Cloud Messaging)
PUSH_ENABLED=1
PUSH_MODE=topic
FCM_PROJECT_ID=antrenor-app
FCM_CREDENTIALS_JSON=/app/secrets/fcm-service-account.json
PUSH_MAX_PER_RUN=50

# ---- Kurumsal
APP_NAME=Antrenör
SUPPORT_EMAIL=destek@antrenorapp.com
