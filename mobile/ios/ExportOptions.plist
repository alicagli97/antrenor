<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  IPA disa aktarma ayarlari (GitHub Actions iOS is akisi kullanir).

  teamID gizli bir bilgi degil, uygulama ustverisinde zaten gorunur.
  Apple Developer hesabinda Membership details altinda yaziyor.

-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>U6ST935722</string>

	<key>signingStyle</key>
	<string>manual</string>

	<!-- Elle imzalamada profil eslesmesi acikca yazilmali -->
	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<key>provisioningProfiles</key>
	<dict>
		<key>com.antrenorapp.antrenor</key>
		<string>Antrenor App Store</string>
	</dict>

	<!-- Bitcode Xcode 14'ten beri kullanilmiyor -->
	<key>uploadBitcode</key>
	<false/>

	<!-- Sembol dosyalari cokme raporlarinin okunabilir olmasini sagliyor -->
	<key>uploadSymbols</key>
	<true/>

	<key>destination</key>
	<string>export</string>
</dict>
</plist>
